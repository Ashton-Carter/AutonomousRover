{
  "version": 4,
  "configurations": [
    {
      "name": "RaspberryPi5",
      "compilerPath": "/usr/bin/clang",
      "intelliSenseMode": "linux-clang-arm64",
      "cStandard": "gnu11",
      "compilerArgs": [
        "-pthread"
      ],
      "includePath": [
        "${workspaceFolder}/RaspberryPi5",
        "${workspaceFolder}/RaspberryPi5/**",
        "${workspaceFolder}/.vscode/intellisense"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/RaspberryPi5",
          "${workspaceFolder}/.vscode/intellisense"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "defines": [
        "_GNU_SOURCE"
      ]
    }
  ]
}
